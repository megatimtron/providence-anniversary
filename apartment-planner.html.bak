<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apartment Furniture Planner | Timothy & Ugo</title>
    <script>
        if (!sessionStorage.getItem('authenticated')) {
            window.location.href = 'index.html';
        }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
        .room { cursor: pointer; transition: all 0.3s ease; }
        .room:hover { filter: brightness(0.9); }
        .room.selected { stroke: #C07F63; stroke-width: 4; }
        .furniture-item {
            cursor: grab;
            user-select: none;
            transition: transform 0.2s ease;
        }
        .furniture-item:hover { transform: scale(1.1); }
        .furniture-item.dragging {
            cursor: grabbing;
            opacity: 0.8;
            z-index: 1000;
        }
        .placed-furniture {
            cursor: move;
            filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.3));
        }
        .placed-furniture:hover {
            filter: drop-shadow(2px 2px 8px rgba(192,127,99,0.5));
        }
        .room-label {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
            font-weight: 600;
            pointer-events: none;
        }
        .dimension {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
            font-size: 10px;
            fill: #666;
            pointer-events: none;
        }
        .sidebar {
            background: linear-gradient(135deg, #FDF8F0 0%, #F9F1E6 100%);
        }
        .furniture-palette {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }
        .palette-item {
            background: white;
            border: 2px solid #E5E7EB;
            border-radius: 8px;
            padding: 8px;
            text-align: center;
            cursor: grab;
            transition: all 0.2s ease;
        }
        .palette-item:hover {
            border-color: #C07F63;
            box-shadow: 0 2px 8px rgba(192,127,99,0.2);
        }
        .palette-item span {
            font-size: 24px;
            display: block;
            margin-bottom: 4px;
        }
        .palette-item small {
            font-size: 10px;
            color: #666;
        }
        .info-panel {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        .budget-bar {
            height: 8px;
            border-radius: 4px;
            background: #E5E7EB;
            overflow: hidden;
        }
        .budget-fill {
            height: 100%;
            background: linear-gradient(90deg, #C07F63, #A9684C);
            transition: width 0.3s ease;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div>
                <h1 style="font-family: 'Playfair Display', serif;" class="text-2xl font-bold text-gray-800">Apartment Planner</h1>
                <p class="text-sm text-gray-500">Timothy & Ugo's New Home</p>
            </div>
            <div class="flex gap-3">
                <button onclick="clearAllFurniture()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-xl hover:bg-gray-300 transition text-sm">Clear All</button>
                <button onclick="savePlan()" class="px-4 py-2 bg-orange-600 text-white rounded-xl hover:bg-orange-700 transition text-sm">Save Plan</button>
                <a href="main.html" class="px-4 py-2 bg-gray-800 text-white rounded-xl hover:bg-gray-900 transition text-sm">Back to Site</a>
            </div>
        </div>
    </header>

    <div class="flex h-[calc(100vh-64px)]">
        <!-- Sidebar - Furniture Palette -->
        <aside class="sidebar w-72 p-4 overflow-y-auto border-r border-gray-200">
            <h2 class="font-semibold text-gray-800 mb-3">Furniture</h2>

            <!-- Bedroom Furniture -->
            <div class="mb-4">
                <h3 class="text-xs uppercase text-gray-500 mb-2">Bedroom</h3>
                <div class="furniture-palette">
                    <div class="palette-item" draggable="true" data-type="bed-queen" data-width="60" data-height="80">
                        <span>🛏️</span>
                        <small>Queen Bed</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="nightstand" data-width="24" data-height="24">
                        <span>🪑</span>
                        <small>Nightstand</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="dresser" data-width="54" data-height="20">
                        <span>🗄️</span>
                        <small>Dresser</small>
                    </div>
                </div>
            </div>

            <!-- Living Room Furniture -->
            <div class="mb-4">
                <h3 class="text-xs uppercase text-gray-500 mb-2">Living Room</h3>
                <div class="furniture-palette">
                    <div class="palette-item" draggable="true" data-type="sofa" data-width="84" data-height="36">
                        <span>🛋️</span>
                        <small>Sofa</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="coffee-table" data-width="48" data-height="24">
                        <span>☕</span>
                        <small>Coffee Table</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="tv-stand" data-width="54" data-height="18">
                        <span>📺</span>
                        <small>TV Stand</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="armchair" data-width="32" data-height="32">
                        <span>🪑</span>
                        <small>Armchair</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="rug" data-width="72" data-height="96">
                        <span>🟫</span>
                        <small>Area Rug</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="floor-lamp" data-width="12" data-height="12">
                        <span>💡</span>
                        <small>Floor Lamp</small>
                    </div>
                </div>
            </div>

            <!-- Dining Furniture -->
            <div class="mb-4">
                <h3 class="text-xs uppercase text-gray-500 mb-2">Dining</h3>
                <div class="furniture-palette">
                    <div class="palette-item" draggable="true" data-type="dining-table" data-width="48" data-height="36">
                        <span>🍽️</span>
                        <small>Dining Table</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="dining-chair" data-width="18" data-height="18">
                        <span>🪑</span>
                        <small>Chair</small>
                    </div>
                </div>
            </div>

            <!-- Office Furniture -->
            <div class="mb-4">
                <h3 class="text-xs uppercase text-gray-500 mb-2">Office</h3>
                <div class="furniture-palette">
                    <div class="palette-item" draggable="true" data-type="desk" data-width="54" data-height="28">
                        <span>🖥️</span>
                        <small>Desk</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="office-chair" data-width="24" data-height="24">
                        <span>💺</span>
                        <small>Office Chair</small>
                    </div>
                    <div class="palette-item" draggable="true" data-type="bookshelf" data-width="36" data-height="12">
                        <span>📚</span>
                        <small>Bookshelf</small>
                    </div>
                </div>
            </div>

            <!-- Budget Tracker -->
            <div class="mt-6 p-4 bg-white rounded-xl shadow-sm">
                <h3 class="font-semibold text-gray-800 mb-2">Budget Tracker</h3>
                <div class="budget-bar mb-2">
                    <div class="budget-fill" id="budgetFill" style="width: 0%"></div>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-600">$<span id="spentAmount">0</span></span>
                    <span class="text-gray-400">/ $7,000</span>
                </div>
            </div>
        </aside>

        <!-- Main Floor Plan Area -->
        <main class="flex-1 p-6 overflow-auto flex items-center justify-center bg-gray-50">
            <div class="relative">
                <svg id="floorPlan" width="800" height="600" viewBox="0 0 800 600" class="bg-white rounded-xl shadow-sm">
                    <!-- Background -->
                    <rect width="800" height="600" fill="#FAFAFA"/>

                    <!-- Main Apartment Layout -->
                    <g transform="translate(50, 30)">
                        <!-- BALCONY (top - rectangular, spans across) -->
                        <rect x="0" y="0" width="550" height="50" fill="#E8E8E8" stroke="#374151" stroke-width="3"/>
                        <text x="275" y="30" text-anchor="middle" class="room-label" fill="#666" font-size="12">BALCONY</text>
                        <!-- Balcony railing pattern -->
                        <line x1="10" y1="45" x2="540" y2="45" stroke="#999" stroke-width="1"/>

                        <!-- Main apartment outline below balcony -->
                        <rect x="0" y="50" width="550" height="480" fill="none" stroke="#374151" stroke-width="8"/>

                        <!-- BEDROOM (left side, below balcony) -->
                        <rect x="4" y="54" width="180" height="190" fill="#E8F4E8" class="room" data-room="bedroom"/>
                        <text x="94" y="140" text-anchor="middle" class="room-label" fill="#2D5A2D" font-size="14">BEDROOM</text>
                        <text x="94" y="160" text-anchor="middle" class="dimension">11'6" x 11'5"</text>
                        <!-- Sliding door to balcony -->
                        <rect x="40" y="50" width="100" height="6" fill="#87CEEB" opacity="0.8"/>

                        <!-- LIVING / DINING (right side, below balcony) -->
                        <rect x="188" y="54" width="358" height="250" fill="#E8EEF4" class="room" data-room="living"/>
                        <!-- Wood floor pattern lines -->
                        <g stroke="#D4D8DC" stroke-width="1" opacity="0.4">
                            <line x1="192" y1="80" x2="542" y2="80"/>
                            <line x1="192" y1="110" x2="542" y2="110"/>
                            <line x1="192" y1="140" x2="542" y2="140"/>
                            <line x1="192" y1="170" x2="542" y2="170"/>
                            <line x1="192" y1="200" x2="542" y2="200"/>
                            <line x1="192" y1="230" x2="542" y2="230"/>
                            <line x1="192" y1="260" x2="542" y2="260"/>
                            <line x1="192" y1="290" x2="542" y2="290"/>
                        </g>
                        <text x="370" y="170" text-anchor="middle" class="room-label" fill="#2D4A5A" font-size="14">LIVING / DINING</text>
                        <text x="370" y="190" text-anchor="middle" class="dimension">12'3" x 17'4"</text>
                        <!-- Sliding door to balcony -->
                        <rect x="280" y="50" width="120" height="6" fill="#87CEEB" opacity="0.8"/>

                        <!-- WALK-IN CLOSET (below bedroom, left side) -->
                        <rect x="4" y="248" width="90" height="100" fill="#F4F0E8" class="room" data-room="closet"/>
                        <text x="49" y="290" text-anchor="middle" class="room-label" fill="#5A4A2D" font-size="10">WALK-IN</text>
                        <text x="49" y="305" text-anchor="middle" class="room-label" fill="#5A4A2D" font-size="10">CLOSET</text>
                        <!-- W/D side by side -->
                        <rect x="10" y="310" width="32" height="30" fill="#DDD" stroke="#999" stroke-width="1"/>
                        <text x="26" y="329" text-anchor="middle" font-size="8" fill="#666">W</text>
                        <rect x="47" y="310" width="32" height="30" fill="#DDD" stroke="#999" stroke-width="1"/>
                        <text x="63" y="329" text-anchor="middle" font-size="8" fill="#666">D</text>

                        <!-- BATHROOM (bottom-left corner) -->
                        <rect x="4" y="352" width="90" height="124" fill="#E8F0F4" class="room" data-room="bathroom"/>
                        <text x="49" y="410" text-anchor="middle" class="room-label" fill="#2D4A5A" font-size="12">BATH</text>
                        <!-- Tub -->
                        <rect x="8" y="400" width="32" height="70" fill="#D4E8F0" stroke="#999" stroke-width="1" rx="3"/>
                        <!-- Toilet -->
                        <ellipse cx="70" cy="440" rx="12" ry="16" fill="#FFF" stroke="#999" stroke-width="1"/>
                        <!-- Sink -->
                        <rect x="55" y="360" width="30" height="22" fill="#D4E8F0" stroke="#999" stroke-width="1" rx="2"/>

                        <!-- KITCHEN (bottom right - matching your image) -->
                        <rect x="150" y="308" width="200" height="218" fill="#F8F8F4" class="room" data-room="kitchen"/>
                        <text x="250" y="420" text-anchor="middle" class="room-label" fill="#5A5A2D" font-size="14">KITCHEN</text>

                        <!-- Kitchen layout matching your image -->
                        <!-- Top counter with DW and sink -->
                        <rect x="155" y="312" width="140" height="24" fill="#E8E0D4" stroke="#AAA" stroke-width="1"/>
                        <!-- DW -->
                        <rect x="160" y="314" width="35" height="20" fill="#DDD" stroke="#999" stroke-width="1"/>
                        <text x="177" y="328" text-anchor="middle" font-size="8" fill="#666">DW</text>
                        <!-- Sink -->
                        <rect x="200" y="314" width="40" height="20" fill="#D4E8F0" stroke="#999" stroke-width="1" rx="2"/>
                        <ellipse cx="220" cy="324" rx="12" ry="6" fill="#C4D8E0" stroke="#888"/>

                        <!-- Right side counter with stove -->
                        <rect x="322" y="312" width="24" height="160" fill="#E8E0D4" stroke="#AAA" stroke-width="1"/>
                        <!-- Stove with 4 burners -->
                        <rect x="324" y="350" width="20" height="50" fill="#333" stroke="#666" stroke-width="1"/>
                        <circle cx="329" cy="360" r="5" fill="#555" stroke="#777"/>
                        <circle cx="339" cy="360" r="5" fill="#555" stroke="#777"/>
                        <circle cx="329" cy="385" r="6" fill="#555" stroke="#777"/>
                        <circle cx="339" cy="385" r="6" fill="#555" stroke="#777"/>

                        <!-- REF (bottom center of kitchen) -->
                        <rect x="220" y="475" width="50" height="45" fill="#DDD" stroke="#999" stroke-width="1"/>
                        <text x="245" y="502" text-anchor="middle" font-size="9" fill="#666">REF</text>

                        <!-- Entry/Hallway area -->
                        <rect x="354" y="308" width="192" height="218" fill="#FAF9F6" class="room" data-room="entry"/>
                        <text x="450" y="420" text-anchor="middle" class="room-label" fill="#666" font-size="12">ENTRY</text>
                        <!-- Entry door -->
                        <rect x="500" y="520" width="42" height="8" fill="#8B4513"/>
                        <text x="521" y="518" text-anchor="middle" font-size="8" fill="#666">DOOR</text>

                        <!-- Interior walls -->
                        <!-- Wall between bedroom and living -->
                        <line x1="184" y1="50" x2="184" y2="308" stroke="#374151" stroke-width="4"/>
                        <!-- Wall below bedroom -->
                        <line x1="0" y1="244" x2="98" y2="244" stroke="#374151" stroke-width="4"/>
                        <!-- Closet/Bath divider -->
                        <line x1="0" y1="348" x2="98" y2="348" stroke="#374151" stroke-width="4"/>
                        <!-- Wall between closet/bath and kitchen -->
                        <line x1="98" y1="244" x2="98" y2="530" stroke="#374151" stroke-width="4"/>
                        <!-- Wall above kitchen -->
                        <line x1="98" y1="304" x2="550" y2="304" stroke="#374151" stroke-width="4"/>
                        <!-- Wall between kitchen and entry -->
                        <line x1="350" y1="304" x2="350" y2="530" stroke="#374151" stroke-width="4"/>

                        <!-- Doors -->
                        <!-- Bedroom door -->
                        <rect x="140" y="240" width="40" height="8" fill="#FAFAFA"/>
                        <!-- Closet door -->
                        <rect x="94" y="260" width="8" height="35" fill="#FAFAFA"/>
                        <!-- Bathroom door -->
                        <rect x="50" y="344" width="40" height="8" fill="#FAFAFA"/>

                        <!-- Entry door (bottom of apartment) -->
                        <rect x="400" y="472" width="55" height="8" fill="#8B4513"/>
                        <text x="427" y="468" text-anchor="middle" font-size="9" fill="#666">ENTRY</text>
                    </g>

                    <!-- Furniture container -->
                    <g id="furnitureLayer" transform="translate(60, 40)"></g>

                    <!-- Scale indicator -->
                    <g transform="translate(580, 540)">
                        <line x1="0" y1="0" x2="100" y2="0" stroke="#666" stroke-width="2"/>
                        <line x1="0" y1="-5" x2="0" y2="5" stroke="#666" stroke-width="2"/>
                        <line x1="100" y1="-5" x2="100" y2="5" stroke="#666" stroke-width="2"/>
                        <text x="50" y="20" text-anchor="middle" font-size="12" fill="#666">~10 feet</text>
                    </g>
                </svg>
            </div>
        </main>

        <!-- Right Panel - Room Info -->
        <aside class="w-80 p-4 bg-white border-l border-gray-200 overflow-y-auto">
            <div id="roomInfo" class="info-panel p-4">
                <h2 style="font-family: 'Playfair Display', serif;" class="text-xl font-bold text-gray-800 mb-2">Select a Room</h2>
                <p class="text-gray-500 text-sm">Click on any room in the floor plan to see furniture recommendations and tips.</p>
            </div>

            <!-- Placed Furniture List -->
            <div class="mt-4">
                <h3 class="font-semibold text-gray-800 mb-2">Placed Furniture</h3>
                <ul id="placedList" class="text-sm text-gray-600 space-y-1">
                    <li class="text-gray-400 italic">No furniture placed yet</li>
                </ul>
            </div>

            <!-- Tips -->
            <div class="mt-6 p-4 bg-orange-50 rounded-xl">
                <h3 class="font-semibold text-orange-800 mb-2">Quick Tips</h3>
                <ul class="text-sm text-orange-700 space-y-1">
                    <li>• Drag furniture from the left panel</li>
                    <li>• Click placed items to remove them</li>
                    <li>• Click rooms for recommendations</li>
                    <li>• Save your plan to keep it!</li>
                </ul>
            </div>
        </aside>
    </div>

    <script>
        // Room information data
        const roomData = {
            bedroom: {
                name: 'Bedroom',
                size: '11\'6" x 11\'5" (~126 sq ft)',
                priority: ['Queen Bed', 'Nightstands (2)', 'Dresser'],
                tips: [
                    'Keep 24" walking space on each side of bed',
                    'Position bed to face door but not directly in line',
                    'Consider bed frame with storage drawers',
                    'Use vertical space - wall shelves, hooks'
                ],
                budget: '$1,360 - $3,550'
            },
            living: {
                name: 'Living / Dining',
                size: '12\'3" x 17\'4" (~213 sq ft)',
                priority: ['Sofa (72-84")', 'Coffee Table', 'TV Stand', 'Dining Table', 'Dining Chairs (4)'],
                tips: [
                    'TV viewing distance: 6-8 feet for 50" TV',
                    'Area rug 5\'x7\' or 6\'x9\' to define space',
                    'Leave 30-36" walkway around dining table',
                    'Keep 3 feet clear path to balcony door'
                ],
                budget: '$1,680 - $4,550'
            },
            kitchen: {
                name: 'Kitchen',
                size: 'Galley style with DW & REF',
                priority: ['Small appliances', 'Storage containers', 'Dish rack'],
                tips: [
                    'Maximize cabinet storage with organizers',
                    'Use wall-mounted rack for utensils',
                    'Consider a small cart for extra counter space'
                ],
                budget: '$200 - $500'
            },
            bathroom: {
                name: 'Bathroom',
                size: 'Full bath with tub',
                priority: ['Over-toilet storage', 'Shower caddy', 'Bath mat'],
                tips: [
                    'Use over-door hooks for towels/robes',
                    'Stackable bins under sink',
                    'Tension corner shelf in shower'
                ],
                budget: '$145 - $300'
            },
            closet: {
                name: 'Walk-in Closet',
                size: 'With W/D hookups',
                priority: ['Closet organizer system', 'Hangers', 'Storage bins'],
                tips: [
                    'Install double rods for more hanging space',
                    'Velvet hangers save 50% space',
                    'Use door back for hooks/organizers',
                    'Divide space: His & Hers sections'
                ],
                budget: '$250 - $490'
            }
        };

        // Furniture costs for budget tracking
        const furnitureCosts = {
            'bed-queen': 800,
            'nightstand': 100,
            'dresser': 350,
            'sofa': 900,
            'coffee-table': 200,
            'tv-stand': 250,
            'armchair': 300,
            'rug': 200,
            'floor-lamp': 80,
            'dining-table': 350,
            'dining-chair': 100,
            'desk': 250,
            'office-chair': 300,
            'bookshelf': 150
        };

        let placedFurniture = [];
        let draggedItem = null;

        // Room click handlers
        document.querySelectorAll('.room').forEach(room => {
            room.addEventListener('click', function() {
                document.querySelectorAll('.room').forEach(r => r.classList.remove('selected'));
                this.classList.add('selected');

                const roomId = this.dataset.room;
                const data = roomData[roomId];

                if (data) {
                    document.getElementById('roomInfo').innerHTML = `
                        <h2 style="font-family: 'Playfair Display', serif;" class="text-xl font-bold text-gray-800 mb-1">${data.name}</h2>
                        <p class="text-sm text-gray-500 mb-3">${data.size}</p>

                        <h3 class="font-semibold text-gray-700 mb-2">Priority Items:</h3>
                        <ul class="text-sm text-gray-600 mb-4 space-y-1">
                            ${data.priority.map(item => `<li>• ${item}</li>`).join('')}
                        </ul>

                        <h3 class="font-semibold text-gray-700 mb-2">Layout Tips:</h3>
                        <ul class="text-sm text-gray-600 mb-4 space-y-1">
                            ${data.tips.map(tip => `<li class="text-xs">• ${tip}</li>`).join('')}
                        </ul>

                        <div class="bg-green-50 p-3 rounded-xl">
                            <span class="text-sm font-medium text-green-800">Est. Budget: ${data.budget}</span>
                        </div>
                    `;
                }
            });
        });

        // Drag and drop functionality
        document.querySelectorAll('.palette-item').forEach(item => {
            item.addEventListener('dragstart', function(e) {
                draggedItem = {
                    type: this.dataset.type,
                    width: parseInt(this.dataset.width),
                    height: parseInt(this.dataset.height),
                    emoji: this.querySelector('span').textContent
                };
                this.classList.add('dragging');
            });

            item.addEventListener('dragend', function() {
                this.classList.remove('dragging');
            });
        });

        const svg = document.getElementById('floorPlan');
        const furnitureLayer = document.getElementById('furnitureLayer');

        svg.addEventListener('dragover', function(e) {
            e.preventDefault();
        });

        svg.addEventListener('drop', function(e) {
            e.preventDefault();
            if (!draggedItem) return;

            const rect = svg.getBoundingClientRect();
            const scale = 800 / rect.width;
            const x = (e.clientX - rect.left) * scale - 50;
            const y = (e.clientY - rect.top) * scale - 50;

            placeFurniture(draggedItem, x, y);
            draggedItem = null;
        });

        function placeFurniture(item, x, y) {
            const id = 'furniture-' + Date.now();
            const scale = 0.7; // Scale down furniture for floor plan
            const w = item.width * scale;
            const h = item.height * scale;

            const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            g.id = id;
            g.classList.add('placed-furniture');
            g.dataset.type = item.type;
            g.innerHTML = `
                <rect x="${x - w/2}" y="${y - h/2}" width="${w}" height="${h}"
                      fill="#C07F63" fill-opacity="0.3" stroke="#C07F63" stroke-width="2" rx="4"/>
                <text x="${x}" y="${y + 5}" text-anchor="middle" font-size="16">${item.emoji}</text>
            `;

            g.addEventListener('click', function() {
                removeFurniture(id);
            });

            furnitureLayer.appendChild(g);

            placedFurniture.push({
                id: id,
                type: item.type,
                emoji: item.emoji,
                x: x,
                y: y
            });

            updatePlacedList();
            updateBudget();
        }

        function removeFurniture(id) {
            const el = document.getElementById(id);
            if (el) el.remove();
            placedFurniture = placedFurniture.filter(f => f.id !== id);
            updatePlacedList();
            updateBudget();
        }

        function updatePlacedList() {
            const list = document.getElementById('placedList');
            if (placedFurniture.length === 0) {
                list.innerHTML = '<li class="text-gray-400 italic">No furniture placed yet</li>';
            } else {
                list.innerHTML = placedFurniture.map(f =>
                    `<li class="flex justify-between items-center py-1 px-2 bg-gray-50 rounded">
                        <span>${f.emoji} ${f.type.replace('-', ' ')}</span>
                        <button onclick="removeFurniture('${f.id}')" class="text-red-500 hover:text-red-700 text-xs">Remove</button>
                    </li>`
                ).join('');
            }
        }

        function updateBudget() {
            let total = 0;
            placedFurniture.forEach(f => {
                total += furnitureCosts[f.type] || 0;
            });

            document.getElementById('spentAmount').textContent = total.toLocaleString();
            const percentage = Math.min((total / 7000) * 100, 100);
            document.getElementById('budgetFill').style.width = percentage + '%';
        }

        function clearAllFurniture() {
            furnitureLayer.innerHTML = '';
            placedFurniture = [];
            updatePlacedList();
            updateBudget();
        }

        function savePlan() {
            localStorage.setItem('apartmentPlan', JSON.stringify(placedFurniture));
            alert('Plan saved! Your furniture layout has been stored.');
        }

        // Load saved plan on page load
        function loadPlan() {
            const saved = localStorage.getItem('apartmentPlan');
            if (saved) {
                const items = JSON.parse(saved);
                items.forEach(item => {
                    const furniture = {
                        type: item.type,
                        emoji: item.emoji,
                        width: 60,
                        height: 40
                    };
                    // Recreate with original position
                    placeFurnitureAtPosition(furniture, item.x, item.y, item.id);
                });
            }
        }

        function placeFurnitureAtPosition(item, x, y, existingId) {
            const id = existingId || ('furniture-' + Date.now());
            const scale = 0.7;
            const w = (item.width || 60) * scale;
            const h = (item.height || 40) * scale;

            const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            g.id = id;
            g.classList.add('placed-furniture');
            g.dataset.type = item.type;
            g.innerHTML = `
                <rect x="${x - w/2}" y="${y - h/2}" width="${w}" height="${h}"
                      fill="#C07F63" fill-opacity="0.3" stroke="#C07F63" stroke-width="2" rx="4"/>
                <text x="${x}" y="${y + 5}" text-anchor="middle" font-size="16">${item.emoji}</text>
            `;

            g.addEventListener('click', function() {
                removeFurniture(id);
            });

            furnitureLayer.appendChild(g);

            if (!existingId) {
                placedFurniture.push({
                    id: id,
                    type: item.type,
                    emoji: item.emoji,
                    x: x,
                    y: y
                });
            }
        }

        // Initialize
        loadPlan();
    </script>
</body>
</html>
