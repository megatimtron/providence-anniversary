    <script>
        const BUDGET = 7000;
        const SUPABASE_URL = 'https://ltpnhrvpwglitzjkvgwd.supabase.co';
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imx0cG5ocnZwd2dsaXR6amt2Z3dkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjYyNjQ5NzYsImV4cCI6MjA4MTg0MDk3Nn0.AMO9x7GGvkIkCNMPlceX2DPLCaJ_SqaIzOTYYtUU7f0';

        // Initialize Supabase client (with silent logging)
        const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
            auth: { persistSession: false },
            realtime: {
                params: { eventsPerSecond: 10 },
                // Suppress console logs
                logger: undefined
            }
        });
        let checkedItems = {};
        let isOnline = true;

        // Sync status UI helpers
        function setSyncStatus(status, message) {
            const dot = document.getElementById('syncDot');
            const text = document.getElementById('syncText');
            dot.className = 'w-2 h-2 rounded-full';

            switch(status) {
                case 'connected':
                    dot.classList.add('bg-green-500');
                    text.textContent = message || 'Synced';
                    break;
                case 'syncing':
                    dot.classList.add('bg-yellow-500', 'animate-pulse');
                    text.textContent = message || 'Syncing...';
                    break;
                case 'offline':
                    dot.classList.add('bg-red-500');
                    text.textContent = message || 'Offline';
                    break;
                default:
                    dot.classList.add('bg-gray-400', 'animate-pulse');
                    text.textContent = message || 'Connecting...';
            }
        }

        async function loadFromSupabase() {
            try {
                setSyncStatus('syncing', 'Loading...');
                const { data, error } = await supabaseClient
                    .from('furniture_checklist')
                    .select('*');

                console.log('Supabase response:', { data, error });
                if (error) throw error;

                checkedItems = {};
                data.forEach(row => {
                    if (row.is_checked) {
                        checkedItems[row.item_name] = true;
                    }
                });

                // Also save to localStorage as backup
                localStorage.setItem('furnitureChecklist', JSON.stringify(checkedItems));
                isOnline = true;
                setSyncStatus('connected');
                return true;
            } catch (err) {
                console.warn('Supabase load failed, using localStorage:', err);
                checkedItems = JSON.parse(localStorage.getItem('furnitureChecklist') || '{}');
                isOnline = false;
                setSyncStatus('offline', 'Using local');
                return false;
            }
        }

        async function saveToSupabase(itemName, isChecked) {
            try {
                setSyncStatus('syncing');
                const { error } = await supabaseClient
                    .from('furniture_checklist')
                    .upsert({
                        item_name: itemName,
                        is_checked: isChecked,
                        checked_at: isChecked ? new Date().toISOString() : null,
                        updated_at: new Date().toISOString()
                    });

                if (error) throw error;
                isOnline = true;
                setSyncStatus('connected');
            } catch (err) {
                console.warn('Supabase save failed:', err);
                isOnline = false;
                setSyncStatus('offline', 'Saved locally');
            }
        }

        // Sync visual checkbox with actual state
        function syncCheckboxVisual(checkbox) {
            const label = checkbox.closest('label');
            const customCheckbox = label.querySelector('.checkbox-custom');
            if (checkbox.checked) {
                label.classList.add('checked-item');
                if (customCheckbox) customCheckbox.classList.add('checked');
            } else {
                label.classList.remove('checked-item');
                if (customCheckbox) customCheckbox.classList.remove('checked');
            }
        }

        function applyCheckboxState() {
            const checkboxes = document.querySelectorAll('input[type="checkbox"]');
            checkboxes.forEach(cb => {
                const item = cb.dataset.item;
                const shouldBeChecked = !!checkedItems[item];
                if (cb.checked !== shouldBeChecked) {
                    cb.checked = shouldBeChecked;
                }
                syncCheckboxVisual(cb);
            });
            updateTotals();
        }

        async function init() {
            const checkboxes = document.querySelectorAll('input[type="checkbox"]');
            document.getElementById('totalItems').textContent = checkboxes.length;

            // Load initial state from Supabase (falls back to localStorage)
            await loadFromSupabase();
            applyCheckboxState();

            // Subscribe to realtime changes
            supabaseClient
                .channel('furniture_changes')
                .on('postgres_changes',
                    { event: '*', schema: 'public', table: 'furniture_checklist' },
                    (payload) => {
                        console.log('Realtime update:', payload);
                        const { new: newRow, old: oldRow } = payload;

                        if (payload.eventType === 'DELETE' && oldRow) {
                            delete checkedItems[oldRow.item_name];
                        } else if (newRow) {
                            if (newRow.is_checked) {
                                checkedItems[newRow.item_name] = true;
                            } else {
                                delete checkedItems[newRow.item_name];
                            }
                        }

                        localStorage.setItem('furnitureChecklist', JSON.stringify(checkedItems));
                        applyCheckboxState();
                    }
                )
                .subscribe((status) => {
                    if (status === 'SUBSCRIBED') {
                        setSyncStatus('connected', 'Live sync');
                    }
                });

            // Add event listeners
            checkboxes.forEach(cb => {
                cb.addEventListener('change', async function() {
                    const item = this.dataset.item;
                    if (this.checked) {
                        checkedItems[item] = true;
                    } else {
                        delete checkedItems[item];
                    }

                    // Update visual state
                    syncCheckboxVisual(this);

                    // Save to localStorage immediately
                    localStorage.setItem('furnitureChecklist', JSON.stringify(checkedItems));
                    updateTotals();

                    // Sync to Supabase
                    await saveToSupabase(item, this.checked);
                });
            });
        }

        function updateTotals() {
            const checkboxes = document.querySelectorAll('input[type="checkbox"]');
            let totalSpent = 0;
            let itemsChecked = 0;

            checkboxes.forEach(cb => {
                if (cb.checked) {
                    totalSpent += parseInt(cb.dataset.cost);
                    itemsChecked++;
                }
            });

            document.getElementById('totalSpent').textContent = totalSpent.toLocaleString();
            document.getElementById('itemsChecked').textContent = itemsChecked;

            const percentage = (totalSpent / BUDGET) * 100;
            const budgetFill = document.getElementById('budgetFill');
            budgetFill.style.width = Math.min(percentage, 100) + '%';

            budgetFill.classList.remove('warning', 'danger');
            if (percentage > 100) {
                budgetFill.classList.add('danger');
            } else if (percentage > 80) {
                budgetFill.classList.add('warning');
            }
        }

        // ========== ITEM DETAILS FUNCTIONALITY ==========
        let itemLinks = {};      // { itemName: [array of links] }
        let itemDetails = {};    // { itemName: { notes, actual_price, estimated_price } }
        let currentItem = null;
        let currentPreviewData = null;
        let pendingLinks = [];   // Links to add when saving

        // Load all item data
        async function loadItemData() {
            try {
                // Load links
                const { data: linksData, error: linksError } = await supabaseClient
                    .from('item_links')
                    .select('*');

                if (!linksError && linksData) {
                    itemLinks = {};
                    linksData.forEach(link => {
                        if (!itemLinks[link.item_name]) {
                            itemLinks[link.item_name] = [];
                        }
                        itemLinks[link.item_name].push(link);
                    });
                }

                // Load item details (notes, actual prices)
                const { data: detailsData, error: detailsError } = await supabaseClient
                    .from('furniture_checklist')
                    .select('item_name, notes, actual_price, estimated_price');

                if (!detailsError && detailsData) {
                    detailsData.forEach(item => {
                        if (item.notes || item.actual_price) {
                            itemDetails[item.item_name] = item;
                        }
                    });
                }

                renderAllItemExtras();
            } catch (err) {
                console.warn('Failed to load item data:', err);
            }
        }

        // Add edit buttons to each item
        function addEditButtons() {
            const labels = document.querySelectorAll('label[class*="flex items-center"]');
            labels.forEach(label => {
                const checkbox = label.querySelector('input[type="checkbox"]');
                if (!checkbox) return;

                const itemName = checkbox.dataset.item;
                const estimatedPrice = parseInt(checkbox.dataset.cost);
                const priceSpan = label.querySelector('span.text-gray-500:last-child');

                if (priceSpan && !label.querySelector('.action-btn')) {
                    // Create edit button
                    const editBtn = document.createElement('button');
                    editBtn.className = 'action-btn';
                    editBtn.innerHTML = '✏️';
                    editBtn.title = 'Edit item details';
                    editBtn.dataset.item = itemName;
                    editBtn.dataset.estimated = estimatedPrice;
                    editBtn.onclick = (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        openItemModal(itemName, estimatedPrice);
                    };
                    priceSpan.parentNode.insertBefore(editBtn, priceSpan);
                }
            });
        }

        function openItemModal(itemName, estimatedPrice) {
            currentItem = itemName;
            pendingLinks = [];
            currentPreviewData = null;

            const details = itemDetails[itemName] || {};
            const links = itemLinks[itemName] || [];

            // Set modal content
            document.getElementById('modalItemName').textContent = itemName;
            document.getElementById('itemNotes').value = details.notes || '';
            document.getElementById('modalEstimatedPrice').textContent = '$' + estimatedPrice;
            document.getElementById('itemActualPrice').value = details.actual_price || '';

            // Update savings display
            updateSavingsDisplay(estimatedPrice, details.actual_price);

            // Render existing links
            renderExistingLinks(links);

            // Clear link input
            document.getElementById('linkInput').value = '';
            document.getElementById('linkPreviewResult').innerHTML = '';
            document.getElementById('linkPreviewResult').classList.add('hidden');
            document.getElementById('linkPreviewLoading').classList.add('hidden');

            document.getElementById('itemModal').classList.remove('hidden');
        }

        function closeItemModal() {
            document.getElementById('itemModal').classList.add('hidden');
            currentItem = null;
            pendingLinks = [];
        }

        function updateSavingsDisplay(estimated, actual) {
            const savingsDiv = document.getElementById('savingsDisplay');
            const savingsAmount = document.getElementById('savingsAmount');

            if (actual && actual > 0) {
                const diff = estimated - actual;
                savingsDiv.classList.remove('hidden');
                if (diff >= 0) {
                    savingsAmount.textContent = '$' + diff;
                    savingsAmount.className = 'font-bold text-green-600';
                } else {
                    savingsAmount.textContent = '+$' + Math.abs(diff);
                    savingsAmount.className = 'font-bold text-red-600';
                }
            } else {
                savingsDiv.classList.add('hidden');
            }
        }

        function renderExistingLinks(links) {
            const container = document.getElementById('existingLinks');
            if (links.length === 0) {
                container.innerHTML = '<p class="text-gray-400 text-sm">No links added yet</p>';
                return;
            }

            container.innerHTML = links.map(link => `
                <div class="link-preview-mini">
                    ${link.image ? `<img src="${link.image}" alt="" onerror="this.style.display='none'">` : '<div style="width:50px;height:50px;background:#E5E7EB;border-radius:6px;"></div>'}
                    <div class="link-preview-content">
                        <div class="link-preview-title">${link.title || 'View Product'}</div>
                        <div class="link-preview-site">${link.site_name || ''} ${link.price ? '• ' + link.price : ''}</div>
                    </div>
                    <a href="${link.url}" target="_blank" class="text-blue-500 text-sm px-2">Open</a>
                    <button class="delete-link" data-id="${link.id}" title="Remove">&times;</button>
                </div>
            `).join('');

            // Add delete handlers
            container.querySelectorAll('.delete-link').forEach(btn => {
                btn.onclick = () => deleteLink(parseInt(btn.dataset.id));
            });
        }

        async function deleteLink(linkId) {
            try {
                await supabaseClient.from('item_links').delete().eq('id', linkId);
                // Remove from local cache
                for (const itemName in itemLinks) {
                    itemLinks[itemName] = itemLinks[itemName].filter(l => l.id !== linkId);
                }
                renderExistingLinks(itemLinks[currentItem] || []);
                renderAllItemExtras();
            } catch (err) {
                console.error('Failed to delete link:', err);
            }
        }

        async function fetchLinkPreview(url) {
            document.getElementById('linkPreviewLoading').classList.remove('hidden');
            document.getElementById('linkPreviewResult').classList.add('hidden');

            try {
                const response = await fetch('/.netlify/functions/link-preview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url })
                });

                const data = await response.json();
                if (data.error) throw new Error(data.error);

                currentPreviewData = data;
                showPreviewInModal(data);
            } catch (err) {
                currentPreviewData = { url, title: new URL(url).hostname, siteName: new URL(url).hostname };
                showPreviewInModal(currentPreviewData);
            } finally {
                document.getElementById('linkPreviewLoading').classList.add('hidden');
            }
        }

        function showPreviewInModal(data) {
            document.getElementById('linkPreviewResult').innerHTML = `
                <div class="link-preview-mini" style="background:#E8F5E9;border-color:#A5D6A7;">
                    ${data.image ? `<img src="${data.image}" alt="" onerror="this.style.display='none'">` : ''}
                    <div class="link-preview-content">
                        <div class="link-preview-title">${data.title || 'No title'}</div>
                        <div class="link-preview-site">${data.siteName || data.site_name || ''} ${data.price ? '• ' + data.price : ''}</div>
                    </div>
                    <span class="text-green-600 text-xs">Ready to add</span>
                </div>
            `;
            document.getElementById('linkPreviewResult').classList.remove('hidden');
        }

        async function addCurrentLink() {
            if (!currentPreviewData) return;

            try {
                const { data, error } = await supabaseClient
                    .from('item_links')
                    .insert({
                        item_name: currentItem,
                        url: currentPreviewData.url,
                        title: currentPreviewData.title,
                        description: currentPreviewData.description,
                        image: currentPreviewData.image,
                        site_name: currentPreviewData.siteName || currentPreviewData.site_name,
                        price: currentPreviewData.price
                    })
                    .select()
                    .single();

                if (error) throw error;

                // Add to local cache
                if (!itemLinks[currentItem]) itemLinks[currentItem] = [];
                itemLinks[currentItem].push(data);

                // Re-render
                renderExistingLinks(itemLinks[currentItem]);
                document.getElementById('linkInput').value = '';
                document.getElementById('linkPreviewResult').classList.add('hidden');
                currentPreviewData = null;

                renderAllItemExtras();
            } catch (err) {
                console.error('Failed to add link:', err);
                alert('Failed to add link');
            }
        }

        async function saveItemDetails() {
            if (!currentItem) return;

            const notes = document.getElementById('itemNotes').value.trim();
            const actualPrice = document.getElementById('itemActualPrice').value;
            const checkbox = document.querySelector(`input[data-item="${currentItem}"]`);
            const estimatedPrice = checkbox ? parseInt(checkbox.dataset.cost) : 0;

            try {
                const { error } = await supabaseClient
                    .from('furniture_checklist')
                    .upsert({
                        item_name: currentItem,
                        notes: notes || null,
                        actual_price: actualPrice ? parseInt(actualPrice) : null,
                        estimated_price: estimatedPrice,
                        updated_at: new Date().toISOString()
                    });

                if (error) throw error;

                // Update local cache
                itemDetails[currentItem] = { notes, actual_price: actualPrice ? parseInt(actualPrice) : null, estimated_price: estimatedPrice };

                renderAllItemExtras();
                closeItemModal();
            } catch (err) {
                console.error('Failed to save details:', err);
                alert('Failed to save');
            }
        }

        // Render notes and price info under each item
        function renderAllItemExtras() {
            const labels = document.querySelectorAll('label[class*="flex items-center"]');
            labels.forEach(label => {
                const checkbox = label.querySelector('input[type="checkbox"]');
                if (!checkbox) return;

                const itemName = checkbox.dataset.item;
                const estimatedPrice = parseInt(checkbox.dataset.cost);
                const details = itemDetails[itemName] || {};
                const links = itemLinks[itemName] || [];
                const container = label.parentNode;

                // Update edit button style
                const editBtn = label.querySelector('.action-btn');
                if (editBtn) {
                    const hasData = details.notes || details.actual_price || links.length > 0;
                    editBtn.classList.toggle('has-data', hasData);
                }

                // Remove old extras for THIS item only
                let nextEl = label.nextElementSibling;
                while (nextEl && (nextEl.classList.contains('item-note') || nextEl.classList.contains('links-container'))) {
                    const toRemove = nextEl;
                    nextEl = nextEl.nextElementSibling;
                    toRemove.remove();
                }

                // Update price display
                const priceSpan = label.querySelector('span.text-gray-500:last-child');
                if (priceSpan && details.actual_price) {
                    const savings = estimatedPrice - details.actual_price;
                    priceSpan.innerHTML = `
                        <span class="estimated-price">$${estimatedPrice}</span>
                        <span class="actual-price">$${details.actual_price}</span>
                        ${savings > 0 ? `<span class="savings-badge">-$${savings}</span>` :
                          savings < 0 ? `<span class="savings-badge overspent-badge">+$${Math.abs(savings)}</span>` : ''}
                    `;
                } else if (priceSpan) {
                    priceSpan.textContent = '$' + estimatedPrice;
                }

                // Insert extras after label: note first, then links
                let insertPoint = label.nextSibling;

                // Add note if exists
                if (details.notes) {
                    const noteDiv = document.createElement('div');
                    noteDiv.className = 'item-note';
                    noteDiv.textContent = details.notes;
                    container.insertBefore(noteDiv, insertPoint);
                }

                // Add link previews if exist
                if (links.length > 0) {
                    const linksDiv = document.createElement('div');
                    linksDiv.className = 'links-container';
                    linksDiv.innerHTML = links.slice(0, 2).map(link => `
                        <a href="${link.url}" target="_blank" rel="noopener" class="link-preview-mini">
                            ${link.image ? `<img src="${link.image}" alt="" onerror="this.style.display='none'">` : ''}
                            <div class="link-preview-content">
                                <div class="link-preview-title">${link.title || 'View'}</div>
                                <div class="link-preview-site">${link.site_name || ''} ${link.price ? '• ' + link.price : ''}</div>
                            </div>
                        </a>
                    `).join('') + (links.length > 2 ? `<span class="text-xs text-gray-500">+${links.length - 2} more</span>` : '');

                    // Insert after note if it exists, otherwise after label
                    const noteDiv = label.nextElementSibling?.classList.contains('item-note') ? label.nextElementSibling : null;
                    container.insertBefore(linksDiv, noteDiv ? noteDiv.nextSibling : insertPoint);
                }
            });

            updateTotalsWithActual();
        }

        // Update totals using actual prices when available
        function updateTotalsWithActual() {
            const checkboxes = document.querySelectorAll('input[type="checkbox"]');
            let totalSpent = 0;
            let itemsChecked = 0;

            checkboxes.forEach(cb => {
                if (cb.checked) {
                    const itemName = cb.dataset.item;
                    const details = itemDetails[itemName];
                    const price = details?.actual_price || parseInt(cb.dataset.cost);
                    totalSpent += price;
                    itemsChecked++;
                }
            });

            document.getElementById('totalSpent').textContent = totalSpent.toLocaleString();
            document.getElementById('itemsChecked').textContent = itemsChecked;

            const percentage = (totalSpent / BUDGET) * 100;
            const budgetFill = document.getElementById('budgetFill');
            budgetFill.style.width = Math.min(percentage, 100) + '%';

            budgetFill.classList.remove('warning', 'danger');
            if (percentage > 100) {
                budgetFill.classList.add('danger');
            } else if (percentage > 80) {
                budgetFill.classList.add('warning');
            }
        }

        // Modal event listeners
        document.getElementById('modalClose').onclick = closeItemModal;
        document.getElementById('saveItemDetails').onclick = saveItemDetails;
        document.getElementById('itemModal').onclick = (e) => {
            if (e.target.id === 'itemModal') closeItemModal();
        };
        document.getElementById('addLinkBtn').onclick = addCurrentLink;

        document.getElementById('itemActualPrice').oninput = (e) => {
            const checkbox = document.querySelector(`input[data-item="${currentItem}"]`);
            const estimated = checkbox ? parseInt(checkbox.dataset.cost) : 0;
            updateSavingsDisplay(estimated, parseInt(e.target.value) || 0);
        };

        let debounceTimer;
        document.getElementById('linkInput').oninput = (e) => {
            clearTimeout(debounceTimer);
            const url = e.target.value.trim();
            if (url && url.startsWith('http')) {
                debounceTimer = setTimeout(() => fetchLinkPreview(url), 500);
            } else {
                document.getElementById('linkPreviewResult').classList.add('hidden');
                currentPreviewData = null;
            }
        };

        // ========== END ITEM DETAILS ==========

        // ========== CUSTOM ITEMS ==========
        let customItems = [];
        let currentAddRoom = null;

        const roomNames = {
            bedroom: 'Bedroom',
            living: 'Living Room',
            dining: 'Dining Area',
            office: 'Home Office',
            bathroom: 'Bathroom',
            closet: 'Walk-in Closet'
        };

        async function loadCustomItems() {
            try {
                const { data, error } = await supabaseClient
                    .from('custom_items')
                    .select('*')
                    .order('created_at', { ascending: true });

                if (!error && data) {
                    customItems = data;
                    renderCustomItems();
                }
            } catch (err) {
                console.warn('Failed to load custom items:', err);
            }
        }

        function addAddItemButtons() {
            document.querySelectorAll('[data-room]').forEach(roomDiv => {
                const room = roomDiv.dataset.room;
                if (!roomDiv.querySelector('.add-item-btn')) {
                    const btn = document.createElement('button');
                    btn.className = 'add-item-btn';
                    btn.innerHTML = '<span>+</span> Add Custom Item';
                    btn.onclick = () => openAddItemModal(room);
                    roomDiv.appendChild(btn);
                }
            });
        }

        function openAddItemModal(room) {
            currentAddRoom = room;
            document.getElementById('addItemRoom').textContent = roomNames[room] || room;
            document.getElementById('newItemName').value = '';
            document.getElementById('newItemPrice').value = '';
            document.getElementById('newItemPriority').value = '2';
            document.getElementById('addItemModal').classList.remove('hidden');
            document.getElementById('newItemName').focus();
        }

        function closeAddItemModal() {
            document.getElementById('addItemModal').classList.add('hidden');
            currentAddRoom = null;
        }

        async function saveCustomItem() {
            const name = document.getElementById('newItemName').value.trim();
            const price = parseInt(document.getElementById('newItemPrice').value) || 0;
            const priority = document.getElementById('newItemPriority').value;

            if (!name || !currentAddRoom) {
                alert('Please enter an item name');
                return;
            }

            try {
                const { data, error } = await supabaseClient
                    .from('custom_items')
                    .insert({
                        room: currentAddRoom,
                        name: name,
                        estimated_price: price,
                        priority: parseInt(priority)
                    })
                    .select()
                    .single();

                if (error) throw error;

                customItems.push(data);
                renderCustomItem(data);
                closeAddItemModal();
                document.getElementById('totalItems').textContent =
                    document.querySelectorAll('input[type="checkbox"]').length;
            } catch (err) {
                console.error('Failed to save custom item:', err);
                alert('Failed to add item');
            }
        }

        function renderCustomItems() {
            customItems.forEach(item => renderCustomItem(item));
            document.getElementById('totalItems').textContent =
                document.querySelectorAll('input[type="checkbox"]').length;
        }

        function renderCustomItem(item) {
            const roomDiv = document.querySelector(`[data-room="${item.room}"]`);
            if (!roomDiv) return;

            // Check if already rendered
            if (document.querySelector(`input[data-item="${item.name}"][data-custom="true"]`)) return;

            const addBtn = roomDiv.querySelector('.add-item-btn');

            const label = document.createElement('label');
            label.className = 'flex items-center gap-3.5 p-3 rounded-xl hover:bg-gray-50 cursor-pointer custom-item transition-colors';
            label.innerHTML = `
                <input type="checkbox" class="hidden" data-cost="${item.estimated_price}" data-item="${item.name}" data-custom="true" data-id="${item.id}">
                <div class="checkbox-wrapper"><div class="checkbox-custom"></div></div>
                <div class="flex-1 flex items-center gap-2">
                    <span class="text-gray-900 font-medium text-sm">${item.name}</span>
                </div>
                <span class="text-gray-600 font-semibold text-sm">$${item.estimated_price}</span>
            `;

            // Insert before add button
            if (addBtn) {
                roomDiv.insertBefore(label, addBtn);
            } else {
                roomDiv.appendChild(label);
            }

            // Add event listener
            const checkbox = label.querySelector('input[type="checkbox"]');
            checkbox.addEventListener('change', async function() {
                const itemName = this.dataset.item;
                if (this.checked) {
                    checkedItems[itemName] = true;
                } else {
                    delete checkedItems[itemName];
                }
                syncCheckboxVisual(this);
                localStorage.setItem('furnitureChecklist', JSON.stringify(checkedItems));
                updateTotals();
                await saveToSupabase(itemName, this.checked);
            });

            // Restore checked state
            if (checkedItems[item.name]) {
                checkbox.checked = true;
            }
            syncCheckboxVisual(checkbox);

            // Add edit button for custom item
            const priceSpan = label.querySelector('span.text-gray-500');
            if (priceSpan) {
                const editBtn = document.createElement('button');
                editBtn.className = 'action-btn';
                editBtn.innerHTML = '✏️';
                editBtn.title = 'Edit item details';
                editBtn.dataset.item = item.name;
                editBtn.dataset.estimated = item.estimated_price;
                editBtn.onclick = (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    openItemModal(item.name, item.estimated_price);
                };
                priceSpan.parentNode.insertBefore(editBtn, priceSpan);
            }
        }

        // Add item modal event listeners
        document.getElementById('addItemClose').onclick = closeAddItemModal;
        document.getElementById('saveNewItem').onclick = saveCustomItem;
        document.getElementById('addItemModal').onclick = (e) => {
            if (e.target.id === 'addItemModal') closeAddItemModal();
        };

        // ========== END CUSTOM ITEMS ==========

        init();
        addEditButtons();
        addAddItemButtons();
        loadItemData();
        loadCustomItems();
    </script>
</body>
</html>
